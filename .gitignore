# Generated code is tracked so downstream repositories and CI can import
# github.com/cyper98/zenc-protocol/generated/go without needing local protoc
# generated/go/**
# generated/typescript/**
# generated/python/**

# Keep directories
!generated/go/.gitkeep
!generated/typescript/.gitkeep
!generated/python/.gitkeep

# Go
*.so
*.dylib
*.dll
*.exe
*.test
*.out
go.work

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

node_modules/
